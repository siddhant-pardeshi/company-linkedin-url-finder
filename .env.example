# Company Page Finder — resolver configuration
# Copy to .env (never commit it) or set these in your host's secret store.

# brave (production) or mock (local development/demo only)
SEARCH_PROVIDER=mock

# Required when SEARCH_PROVIDER=brave. Server-side only.
BRAVE_API_KEY=

# Required. Comma-separated access tokens; each at least 16 characters.
# Generate one with: openssl rand -hex 32
RESOLVER_ACCESS_TOKENS=replace-with-a-long-random-token

# Optional
PORT=8787
HOST=127.0.0.1
ALLOWED_ORIGINS=
CACHE_TTL_MS=900000
RATE_LIMIT_PER_MINUTE=30
PROVIDER_CONCURRENCY=2
PROVIDER_TIMEOUT_MS=8000
BATCH_TIMEOUT_MS=50000
LOG_LEVEL=info
BRAVE_API_BASE_URL=https://api.search.brave.com/res/v1/web/search
