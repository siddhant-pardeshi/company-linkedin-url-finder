{
  "manifest_version": 3,
  "name": "Company Page Finder",
  "version": "1.1.0",
  "description": "Find evidence-backed LinkedIn company and people profile URLs from a bulk list, with human review.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Company Page Finder",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "downloads"],
  "host_permissions": ["__RESOLVER_ORIGIN__/*"],
  "optional_host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.x.ai/*",
    "https://openrouter.ai/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "homepage_url": "https://github.com/siddhant-pardeshi/company-linkedin-url-finder"
}
